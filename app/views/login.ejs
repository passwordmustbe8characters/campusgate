<%- include('partials/top', { title, csrfToken }) %>
    <h1>Sign in</h1>
    <% if (registered) { %>
      <p class="msg msg-ok">Account created. Open the link we emailed you to confirm your address, then sign in.</p>
    <% } %>
    <% if (locals.flags && locals.flags.verified) { %>
      <p class="msg msg-ok">Email address confirmed. You can now sign in.</p>
    <% } %>
    <% if (locals.flags && locals.flags.admitted) { %>
      <p class="msg msg-ok">It's your turn: sign in now.</p>
    <% } %>
    <form data-api="/auth/login" novalidate>
      <label for="identifier">Matric/staff ID or email</label>
      <input id="identifier" name="identifier" autocomplete="username" required maxlength="254">
      <p class="field-error" data-error-for="identifier"></p>

      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
      <p class="field-error" data-error-for="password"></p>

      <button type="submit">Sign in</button>
      <p class="msg" data-message role="status" aria-live="polite"></p>
    </form>
    <p class="alt"><a href="/forgot-password">Forgot password?</a></p>
    <p class="alt">New student? <a href="/register">Create an account</a></p>
<%- include('partials/bottom') %>
