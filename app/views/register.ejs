<%- include('partials/top', { title, csrfToken }) %>
    <h1>Create account</h1>
    <p class="hint">For registered students. Use the matric number on your school records.</p>
    <form data-api="/auth/register" data-redirect="/login?registered=1" novalidate>
      <label for="matricNo">Matric number</label>
      <input id="matricNo" name="matricNo" autocomplete="username" required maxlength="32" placeholder="SCI/2022/0001">
      <p class="field-error" data-error-for="matricNo"></p>

      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required maxlength="254">
      <p class="field-error" data-error-for="email"></p>

      <label for="password">Password</label>
      <div class="pw-wrap">
        <input id="password" name="password" type="password" autocomplete="new-password" required>
        <button type="button" class="pw-toggle" aria-label="Toggle password visibility">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </button>
      </div>
      <ul class="rules" id="pw-rules">
        <% passwordRules.forEach(function (rule) { %><li><%= rule %></li><% }) %>
      </ul>
      <p class="field-error" data-error-for="password"></p>

      <!-- TODO(Phase 9): check final wording against the Nigeria Data Protection Act 2023 (NFR-5),
           including the IP-address sentence added in Phase 3 (full IPs are stored in the audit log). -->
      <div class="notice">
        <strong>Privacy notice.</strong> We store your matric number, email address, and a one-way hash of
        your password (never the password itself) to give you access to university services. We also record
        sign-in events (time, IP address, device type) to keep accounts secure. These records, including your
        full IP address, are kept in a tamper-evident security log.
      </div>
      <label class="check">
        <input type="checkbox" name="consent" value="true" required>
        I have read the privacy notice.
      </label>
      <p class="field-error" data-error-for="consent"></p>

      <button type="submit">Create account</button>
      <p class="msg" data-message role="status" aria-live="polite"></p>
    </form>
    <p class="alt">Already registered? <a href="/login">Sign in</a></p>
<%- include('partials/bottom') %>
