                <input type="range" id="load-slider" class="cg-slider" min="100" max="5000" step="50" value="1850">
                <div class="cg-slider-ticks">
                  <span>100 (Quiet)</span>
                  <span>2,500 (Fees)</span>
                  <span>5,000 (Hostel Rush)</span>
                </div>
              </div>

              <div class="cg-insp-section">
                <div class="cg-insp-title">
                  <span>Admission Control Mode</span>
                </div>
                <div class="cg-mode-switch" role="group" aria-label="Toggle waiting room">
