                  </div>

                  <div class="cg-metric-item">
                    <div class="cg-metric-row">
                      <span>Unfair Timeout Lockouts</span>
                      <strong class="cg-mono-val cg-text-emerald" id="m-unfair">0 students</strong>
                    </div>
                    <span class="cg-metric-note">FR-P5: HTTP 500/503 never counted</span>
                  </div>
                </div>
              </div>

              <div class="cg-insp-footer">
                <button type="button" class="cg-insp-reset" id="btn-reset-sim">
