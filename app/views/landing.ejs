    <!-- ══════════════════════════════════════════════════════
         SECTION 2: 5-LAYER AUTHENTICATION PIPELINE
    ═══════════════════════════════════════════════════════ -->
    <section class="cg-section" id="layers" aria-labelledby="layers-heading">
      <div class="cg-container">
        <div class="cg-section-head cg-reveal">
          <h2 id="layers-heading">Five sequential layers before a session token is issued.</h2>
          <p>Click any layer below to inspect how CampusGate balances cryptographic strength with rush-hour availability.</p>
        </div>

        <div class="cg-layers-layout cg-reveal">
          <div class="cg-layer-steps" role="tablist" aria-label="Authentication layers">
            <button type="button" class="cg-layer-btn active" data-layer="1" role="tab" aria-selected="true">
              <span class="cg-layer-num">01</span>
              <div class="cg-layer-info">
                <strong>Admission Control &amp; Rate Limiting</strong>
                <span>Redis IP/account counters + signed FIFO waiting-room tickets</span>
              </div>
            </button>

            <button type="button" class="cg-layer-btn" data-layer="2" role="tab" aria-selected="false">
              <span class="cg-layer-num">02</span>
              <div class="cg-layer-info">
                <strong>Bcrypt Cost-10 &amp; Anti-Enumeration</strong>
                <span>Dummy-hash comparison guarantees identical timing and HTTP 401 replies</span>
              </div>
            </button>

            <button type="button" class="cg-layer-btn" data-layer="3" role="tab" aria-selected="false">
              <span class="cg-layer-num">03</span>
              <div class="cg-layer-info">
                <strong>Fair Atomic Temporary Lockout</strong>
                <span>Locks for 15 mins at 5 bad passwords; ignores server timeouts (FR-P5)</span>
              </div>
            </button>

            <button type="button" class="cg-layer-btn" data-layer="4" role="tab" aria-selected="false">
              <span class="cg-layer-num">04</span>
              <div class="cg-layer-info">
                <strong>Second Factor (Email OTP &amp; TOTP)</strong>
                <span>HMAC-SHA256 codes (max 3 tries) &amp; AES-256-GCM authenticator secrets</span>
              </div>
            </button>

            <button type="button" class="cg-layer-btn" data-layer="5" role="tab" aria-selected="false">
              <span class="cg-layer-num">05</span>
              <div class="cg-layer-info">
                <strong>Login-Once JWT &amp; RBAC Authorisation</strong>
                <span>HttpOnly cookie verified across Fees, Hostel &amp; Reg with 0 DB lookups</span>
              </div>
            </button>
          </div>

          <div class="cg-layer-detail-card" id="layer-detail">
            <div class="cg-layer-content-inner" id="layer-content-inner">
              <div class="cg-code-header">
                <span class="cg-code-title" id="layer-code-title">Layer 1 — Redis Rate Limiter &amp; Waiting Room Queue</span>
                <span class="cg-code-badge" id="layer-code-req">FR-P2 · FR-P4</span>
              </div>
              <p class="cg-layer-desc" id="layer-desc">
                Before any CPU-expensive bcrypt hash is computed, CampusGate checks capacity in Redis. Clients exceeding rate limits receive HTTP 429 with Retry-After exponential backoff, while flash crowds receive a signed FIFO queue ticket and are admitted in orderly batches.
              </p>
              <pre class="cg-code-block"><code id="layer-code">// Layer 1: Admission check before password hashing
// Overloaded arrivals receive a signed waiting-room ticket
// Staff and administrators bypass the queue automatically.
if (activeSignIns >= policy.queue_capacity && !user.isStaffOrAdmin) {
  const ticket = await waitingRoom.join(req.ip);
  return res.status(202).json({
    status: 'queued',
    position: ticket.position,
    estimatedWaitSec: ticket.estimatedWaitSec,
  });
}</code></pre>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         SECTION 3: INTERACTIVE TAMPER-EVIDENT AUDIT CHAIN
    ═══════════════════════════════════════════════════════ -->
    <section class="cg-section cg-section-alt" id="audit" aria-labelledby="audit-heading">
      <div class="cg-container">
        <div class="cg-section-head cg-reveal">
          <h2 id="audit-heading">Tamper-Evident HMAC-SHA256 Audit Chain</h2>
          <p>
            Even if a database insider disables PostgreSQL append-only triggers and edits <code>auth_logs</code> directly, every modification breaks the keyed hash chain and is caught by <code>npm run audit -- verify</code>.
          </p>
        </div>

        <div class="cg-audit-controls cg-reveal" role="group" aria-label="Simulate database tampering">
          <button type="button" class="cg-tamper-btn" data-tamper="edit2">
            Edit Row 2 Content
          </button>
          <button type="button" class="cg-tamper-btn" data-tamper="delete3">
            Delete Row 3 (Gap)
          </button>
          <button type="button" class="cg-tamper-btn" data-tamper="swap23">
            Swap Rows 2 &amp; 3
          </button>
          <button type="button" class="cg-tamper-btn" data-tamper="truncTail">
            Delete Newest Row (Tail)
          </button>
          <button type="button" class="cg-tamper-btn cg-tamper-reset" data-tamper="reset">
            Restore Intact Chain ✓
          </button>
        </div>

        <!-- Visual Hash Chain Blocks -->
        <div class="cg-chain-grid cg-reveal" id="audit-chain-grid">
          <div class="cg-chain-block" id="block-1">
            <div class="cg-block-head">
              <span class="cg-seq-badge">seq #1</span>
              <span class="cg-event-tag">login_failure</span>
            </div>
            <div class="cg-block-body">
              <div><small>subject:</small> <code>SCI/2025/0061</code></div>
              <div><small>success:</small> <code>false (bad_password)</code></div>
              <div><small>prev_hash:</small> <code>genesis</code></div>
              <div><small>row_hash:</small> <code>H1 = 9a4f...c81e</code></div>
            </div>
          </div>

          <div class="cg-chain-block" id="block-2">
            <div class="cg-block-head">
              <span class="cg-seq-badge" id="b2-seq">seq #2</span>
              <span class="cg-event-tag" id="b2-event">login_failure</span>
            </div>
            <div class="cg-block-body">
              <div><small>subject:</small> <code>SCI/2025/0061</code></div>
              <div><small>success:</small> <code id="b2-success">false (bad_password)</code></div>
              <div><small>prev_hash:</small> <code id="b2-prev">H1 (9a4f...c81e)</code></div>
              <div><small>row_hash:</small> <code id="b2-row">H2 = 3d7b...e04a</code></div>
            </div>
          </div>

          <div class="cg-chain-block" id="block-3">
            <div class="cg-block-head">
              <span class="cg-seq-badge" id="b3-seq">seq #3</span>
              <span class="cg-event-tag" id="b3-event">otp_verified</span>
            </div>
            <div class="cg-block-body">
              <div><small>subject:</small> <code>SCI/2025/0061</code></div>
              <div><small>success:</small> <code>true (email_otp)</code></div>
              <div><small>prev_hash:</small> <code id="b3-prev">H2 (3d7b...e04a)</code></div>
              <div><small>row_hash:</small> <code id="b3-row">H3 = 7c12...b99f</code></div>
            </div>
          </div>

          <div class="cg-chain-block" id="block-4">
            <div class="cg-block-head">
              <span class="cg-seq-badge">seq #4</span>
              <span class="cg-event-tag">login_success</span>
            </div>
            <div class="cg-block-body">
              <div><small>subject:</small> <code>SCI/2025/0061</code></div>
              <div><small>success:</small> <code>true (jwt_issued)</code></div>
              <div><small>prev_hash:</small> <code>H3 (7c12...b99f)</code></div>
              <div><small>row_hash:</small> <code>H4 = e510...44d2 (Redis Anchor)</code></div>
            </div>
          </div>
        </div>

        <!-- CLI Verification Output Bar -->
        <div class="cg-cli-bar cg-reveal" id="audit-cli-bar">
          <span class="cg-cli-prompt">$ npm run audit -- verify</span>
          <span class="cg-cli-output cg-cli-ok" id="audit-cli-output">
            OK: the chain is intact up to seq 4 (Redis anchor matches H4 · Verified at 14,800 rows/sec).
          </span>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         SECTION 4: EMPIRICAL BENCHMARKS & OMNeT++ STUDY
    ═══════════════════════════════════════════════════════ -->
    <section class="cg-section" id="benchmarks" aria-labelledby="bench-heading">
      <div class="cg-container">
        <div class="cg-section-head cg-reveal">
