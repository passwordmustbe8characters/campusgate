              <div class="cg-insp-section">
                <div class="cg-insp-title">
                  <span>Live Telemetry (Calibrated)</span>
                </div>

                <div class="cg-metric-list">
                  <div class="cg-metric-item">
                    <div class="cg-metric-row">
                      <span>Sign-In Success Rate</span>
                      <strong class="cg-mono-val cg-text-emerald" id="m-success">99.4%</strong>
                    </div>
                    <div class="cg-mbar"><div class="cg-mbar-fill" id="m-success-bar" style="width: 99%"></div></div>
                  </div>

                  <div class="cg-metric-item">
                    <div class="cg-metric-row">
                      <span>95th-Pct Sign-In Time</span>
