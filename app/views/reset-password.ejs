<%- include('partials/top', { title, csrfToken }) %>
    <h1>Choose a new password</h1>
    <form data-api="/auth/password/reset" data-redirect="/login" data-token-from-hash novalidate>
      <input type="hidden" name="token">
      <label for="newPassword">New password</label>
      <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" required>
      <ul class="rules">
        <% passwordRules.forEach(function (rule) { %><li><%= rule %></li><% }) %>
      </ul>
      <p class="field-error" data-error-for="newPassword"></p>
      <button type="submit">Save new password</button>
      <p class="msg" data-message role="status" aria-live="polite"></p>
    </form>
    <p class="alt"><a href="/forgot-password">Request a new link</a></p>
<%- include('partials/bottom') %>
