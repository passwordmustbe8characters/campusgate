<%- include('partials/top', { title, csrfToken }) %>
<%- include('partials/admin-nav') %>
    <h1>Dashboard</h1>
    <p class="hint">Live: updates every 2 seconds. <span data-dash-status></span></p>
    <table class="dashboard">
      <tbody>
        <tr><th>Sign-ins (last minute)</th><td data-metric="signInsPerMin"><%= snapshot.signInsPerMin %></td></tr>
        <tr><th>Failed sign-ins (last minute)</th><td data-metric="failuresPerMin"><%= snapshot.failuresPerMin %></td></tr>
        <tr><th>Lockouts (last minute)</th><td data-metric="lockoutsPerMin"><%= snapshot.lockoutsPerMin %></td></tr>
        <tr><th>Active sessions</th><td data-metric="activeSessions"><%= snapshot.activeSessions %></td></tr>
        <tr><th>Locked accounts</th><td data-metric="lockedAccounts"><%= snapshot.lockedAccounts %></td></tr>
        <tr><th>Waiting-room queue</th><td data-metric="queueLength"><%= snapshot.queueLength %></td></tr>
        <tr><th>Sign-ins in progress</th><td data-metric="signInsInProgress"><%= snapshot.signInsInProgress %></td></tr>
        <tr><th>Average sign-in time (ms)</th><td data-metric="avgSignInMs"><%= snapshot.avgSignInMs === null ? '–' : snapshot.avgSignInMs %></td></tr>
      </tbody>
    </table>
    <h2>Simulate rush hour</h2>
    <p class="hint">Starts virtual students that sign in like real ones (seeded demo accounts only; no real users or emails).
      Turn the waiting room off or on in Policies to compare. Not available in production.</p>
    <form data-api="/admin/simulate" novalidate>
      <label>Number of students <input name="users" inputmode="numeric" value="300" required></label>
      <label>Arriving over (seconds) <input name="rampSec" inputmode="numeric" value="30" required></label>
      <button type="submit">Start</button>
      <p class="msg" data-message role="status" aria-live="polite"></p>
    </form>
    <p data-sim-status class="hint"></p>
    <script src="/public/js/admin-dashboard.js" defer></script>
<%- include('partials/bottom') %>
