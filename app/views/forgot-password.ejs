<%- include('partials/top', { title, csrfToken }) %>
    <h1>Forgot password</h1>
    <p class="hint">Enter the email address on your account. If it exists, we will email you a link to choose a new password.</p>
    <form data-api="/auth/password/forgot" novalidate>
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required maxlength="254">
      <p class="field-error" data-error-for="email"></p>
      <button type="submit">Send reset link</button>
      <p class="msg" data-message role="status" aria-live="polite"></p>
    </form>
    <p class="alt"><a href="/login">Back to sign in</a></p>
<%- include('partials/bottom') %>
