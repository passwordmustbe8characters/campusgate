# Copy to .env and change every "change-me" value. Never commit .env.
# If a password contains URL-special characters (@ : / ? #), percent-encode it in the URLs below.

# --- App ---
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
HEALTH_CHECK_TIMEOUT_MS=2000
DB_POOL_MAX=10
# libuv thread pool size (bcrypt runs here). Must be set before Node starts. Default 4.
UV_THREADPOOL_SIZE=4
# bcrypt cost factor. Allowed 10-14 (lower values only when NODE_ENV=test).
# 10 was chosen by measurement; see docs/PROGRESS.md, Phase 1.
BCRYPT_COST=10

# --- Cookies and CSRF ---
# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CSRF_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# true once the app is served over HTTPS (Phase 9); adds Secure + __Host- prefix to cookies.
COOKIE_SECURE=false

# --- Phase 2 keys (required). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# All three secrets (CSRF_SECRET, TOKEN_HMAC_KEY, TOTP_ENC_KEY) must be different.
# HMAC key for OTPs, backup codes, reset tokens and ticket ids (at least 32 bytes).
TOKEN_HMAC_KEY=change-me-generate-32-random-bytes-base64url
# AES-256-GCM key for TOTP secrets at rest (exactly 32 bytes).
# WARNING: if this key is lost or changed, every stored TOTP secret becomes unreadable
# and those users must re-enrol (npm run admin -- reset-2fa <ID> --confirm).
TOTP_ENC_KEY=change-me-generate-32-random-bytes-base64url

# --- Seed data (npm run seed) ---
# Students with accounts (used by load tests) and students left free for the registration demo.
SEED_REGISTERED_STUDENTS=1500
SEED_FREE_STUDENTS=500
# Must satisfy the password policy (8+ chars, an uppercase letter, a special character, not common).
SEED_STUDENT_PASSWORD=change-me-Student-1!
SEED_STAFF_PASSWORD=change-me-Staff-1!
SEED_ADMIN_PASSWORD=change-me-Admin-1!

# --- PostgreSQL (used by docker-compose to create the database) ---
POSTGRES_USER=campusgate
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=campusgate

# --- Redis (docker-compose starts Redis with this password) ---
REDIS_PASSWORD=change-me-redis

# --- Connection URLs for running the app or migrations on the host (npm run dev / migrate).
# Inside Docker, docker-compose.yml overrides these to point at the postgres/redis services.
DATABASE_URL=postgres://campusgate:change-me-db@localhost:5432/campusgate
REDIS_URL=redis://:change-me-redis@localhost:6379
