# Copy to .env and change every "change-me" value. Never commit .env.
# If a password contains URL-special characters (@ : / ? #), percent-encode it in the URLs below.

# --- App ---
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
HEALTH_CHECK_TIMEOUT_MS=2000
DB_POOL_MAX=10
# libuv thread pool size (bcrypt runs here). Must be set before Node starts. Default 4.
UV_THREADPOOL_SIZE=4
# bcrypt cost factor. Allowed 10-14 (lower values only when NODE_ENV=test).
# 10 was chosen by measurement; see docs/PROGRESS.md, Phase 1.
BCRYPT_COST=10

# --- Cookies and CSRF ---
# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CSRF_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# true once the app is served over HTTPS (Phase 9); adds Secure + __Host- prefix to cookies.
COOKIE_SECURE=false

# --- Phase 2 keys (required). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# All three secrets (CSRF_SECRET, TOKEN_HMAC_KEY, TOTP_ENC_KEY) must be different.
# HMAC key for OTPs, backup codes, reset tokens and ticket ids (at least 32 bytes).
TOKEN_HMAC_KEY=change-me-generate-32-random-bytes-base64url
# AES-256-GCM key for TOTP secrets at rest (exactly 32 bytes).
# WARNING: if this key is lost or changed, every stored TOTP secret becomes unreadable
# and those users must re-enrol (npm run admin -- reset-2fa <ID> --confirm).
TOTP_ENC_KEY=change-me-generate-32-random-bytes-base64url

# --- Phase 3: audit log (required) ---
# HMAC key for the tamper-evident audit chain (at least 32 bytes, base64url). Never stored in the database.
# WARNING: if this key is lost or changed, existing audit chains can no longer be verified.
# Must differ from CSRF_SECRET, TOKEN_HMAC_KEY and TOTP_ENC_KEY.
AUDIT_HMAC_KEY=change-me-generate-32-random-bytes-base64url

# --- Phase 4: login-once session (required) ---
# HS256 key that signs session tokens (at least 32 bytes, base64url). Changing it signs everyone out.
# Must differ from every key above. Session lifetime is policies.session_timeout_min (admin CLI: policy set).
JWT_SECRET=change-me-generate-32-random-bytes-base64url

# --- Phase 5: rate limiting per minute (429 + Retry-After over the limit) ---
# Per IP is generous: a whole campus can share one public IP. Per account is tight.
RATE_LIMIT_IP_PER_MIN=300
RATE_LIMIT_ACCOUNT_PER_MIN=10

# --- Phase 5: waiting room (capacity, batch size and interval are in the policies table) ---
# A sign-in pass holds its place this long unless the sign-in completes sooner.
QUEUE_PASS_TTL_SEC=120
# A queued ticket whose page stops polling is dropped after this long.
QUEUE_TICKET_TIMEOUT_SEC=30

# --- Message delivery (FR-A14): email | console | sms-mock ---
# email: SMTP (Mailpit in development, web UI http://localhost:8025).
# console: prints codes/links to stdout; development/test only, refused in production.
# sms-mock: stores messages in a Redis list by matric number; mock only, refused in production.
OTP_DELIVERY_DRIVER=email
DELIVERY_TIMEOUT_MS=10000
# Host runs use Mailpit's published port; inside Docker, compose sets SMTP_HOST=mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusGate <no-reply@campusgate.test>
# Real email (e.g. Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-character Google App Password>, MAIL_FROM=CampusGate <you@gmail.com>.
# Inside Docker the app uses Mailpit unless these three are set too:
# DOCKER_SMTP_HOST=smtp.gmail.com
# DOCKER_SMTP_PORT=465
# DOCKER_SMTP_SECURE=true
# Base URL used in emailed links (password reset).
APP_BASE_URL=http://localhost:3000

# --- Second factor and recovery limits ---
PREAUTH_TTL_SEC=300
PREAUTH_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60
RESET_TOKEN_TTL_MIN=30
RESET_COOLDOWN_SEC=60

# --- Seed data (npm run seed) ---
# Students with accounts (used by load tests) and students left free for the registration demo.
SEED_REGISTERED_STUDENTS=1500
SEED_FREE_STUDENTS=500
# Must satisfy the password policy (8+ chars, an uppercase letter, a special character, not common).
SEED_STUDENT_PASSWORD=change-me-Student-1!
SEED_STAFF_PASSWORD=change-me-Staff-1!
SEED_ADMIN_PASSWORD=change-me-Admin-1!

# --- PostgreSQL (used by docker-compose to create the database) ---
POSTGRES_USER=campusgate
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=campusgate

# --- Redis (docker-compose starts Redis with this password) ---
REDIS_PASSWORD=change-me-redis

# --- Connection URLs for running the app or migrations on the host (npm run dev / migrate).
# Inside Docker, docker-compose.yml overrides these to point at the postgres/redis services.
DATABASE_URL=postgres://campusgate:change-me-db@localhost:5432/campusgate
REDIS_URL=redis://:change-me-redis@localhost:6379
