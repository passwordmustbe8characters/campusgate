{
  "name": "campusgate",
  "version": "0.1.0",
  "private": true,
  "description": "Centralized AAA (Authentication, Authorization, Accounting) system for a university network, built for peak-load access.",
  "type": "commonjs",
  "main": "app/src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nodemon --watch app app/src/server.js",
    "start": "node app/src/server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "migrate": "knex migrate:latest --knexfile knexfile.js",
    "migrate:make": "knex migrate:make --knexfile knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.js",
    "seed": "knex seed:run --knexfile knexfile.js",
    "admin": "node scripts/admin-cli.js",
    "audit": "node scripts/audit-cli.js",
    "bench:bcrypt": "node scripts/bcrypt-bench.js",
    "loadtest": "node scripts/not-yet.js loadtest 8",
    "calibrate": "node scripts/not-yet.js calibrate 8"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "roots": [
          "<rootDir>/tests/unit"
        ]
      },
      {
        "displayName": "integration",
        "testEnvironment": "node",
        "roots": [
          "<rootDir>/tests/integration"
        ],
        "globalSetup": "<rootDir>/tests/integration/globalSetup.js",
        "setupFilesAfterEnv": [
          "<rootDir>/tests/integration/setup.js"
        ]
      }
    ]
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^18.0.7",
    "ejs": "^6.0.1",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "9.0.3",
    "knex": "^3.3.0",
    "nodemailer": "10.0.13",
    "otplib": "13.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
